# Copy this file to .env and fill in your own values. .env is git-ignored.

# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# FALSE = Gemini Developer API (the GOOGLE_API_KEY above). TRUE = Vertex AI,
# which instead needs GOOGLE_CLOUD_PROJECT and `gcloud auth application-default login`.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Only needed if GOOGLE_GENAI_USE_VERTEXAI=TRUE.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Works around a protobuf C++/pure-Python implementation conflict between
# chromadb's bundled OTLP exporter and newer protobuf runtimes. See the
# comment in app/config.py for why this has to be set here (before
# `streamlit run` even starts) rather than inside the app itself.
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# Optional: LangSmith, for exporting eval results (see evals/README.md).
# Service key (lsv2_sk_...) preferred; a personal token (lsv2_pt_...) also works.
LANGSMITH_API_KEY=your-langsmith-api-key-here
# Only if you're on the EU region or self-hosted:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Only if your key is org-scoped and you have multiple workspaces:
# LANGSMITH_WORKSPACE_ID=
